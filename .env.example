# CivicTrack Backend Environment Configuration
# Leave DATABASE_URL blank to use local SQLite demo database (civictrack_demo.db)
# For PostgreSQL / Supabase:
# DATABASE_URL=postgresql+psycopg://postgres:<password>@db.<project>.supabase.co:5432/postgres
DATABASE_URL=

# Security
SECRET_KEY=change-this-to-a-secure-random-string-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=720

# CORS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional Supabase Storage (falls back to local backend/uploads/ when unset)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_STORAGE_BUCKET=civictrack-images

# Optional External Vision AI API (falls back to transparent Python heuristic classifier when unset)
VISION_AI_PROVIDER=fallback
OPENAI_API_KEY=
GEMINI_API_KEY=

# Configurable Thresholds
DUPLICATE_RADIUS_METERS=75
RECURRENCE_RADIUS_METERS=85
VERIFICATION_MIN_VOTES=2
VERIFICATION_PASS_RATIO=0.5
DEFAULT_SLA_HOURS=72
